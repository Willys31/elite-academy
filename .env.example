# ============================================================
# Elite Academy – variables d'environnement
# Copier ce fichier vers .env.local puis remplir les valeurs.
# NE JAMAIS committer .env.local ni exposer les clés secrètes.
# ============================================================

# --- Supabase (projet à créer sur https://supabase.com) ---
# URL du projet (publique, visible côté navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé "anon" publique (protégée par Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé "service_role" – STRICTEMENT côté serveur.
# Utilisée uniquement par les actions serveur / Edge Functions.
# Jamais préfixée NEXT_PUBLIC_. Jamais dans le code frontend.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# --- Génération IA (appels uniquement côté serveur) ---
# Clé API Anthropic : https://console.anthropic.com → API Keys.
# STRICTEMENT côté serveur, jamais préfixée NEXT_PUBLIC_.
ANTHROPIC_API_KEY=votre-cle-api-anthropic

# Modèle utilisé pour la génération (modifiable sans toucher au code).
ANTHROPIC_MODEL=claude-sonnet-4-5

# Mode de test SANS clé API et sans coût : décommentez la ligne
# ci-dessous pour produire des contenus de démonstration clairement
# étiquetés (pipeline complet testable : traçabilité, brouillon,
# validation). À retirer pour activer la vraie génération.
# ELITE_IA_MODE=simulation
