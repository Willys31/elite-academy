# ============================================================
# Elite Academy – variables d'environnement
# Copier ce fichier vers .env.local puis remplir les valeurs.
# NE JAMAIS committer .env.local ni exposer les clés secrètes.
# ============================================================

# --- Supabase (projet à créer sur https://supabase.com) ---
# URL du projet (publique, visible côté navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé "anon" publique (protégée par Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé "service_role" – STRICTEMENT côté serveur.
# Utilisée uniquement par les actions serveur / Edge Functions.
# Jamais préfixée NEXT_PUBLIC_. Jamais dans le code frontend.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# --- Génération IA (appels uniquement côté serveur) ---
# L'IA (assistant de création, import de documents, tuteur, exercices,
# analyse de session) passe par UN fournisseur choisi avec LLM_PROVIDER.
# Tous sauf Anthropic parlent le protocole « OpenAI compatible »
# (/chat/completions) : DeepSeek, OpenAI, Gemini, Groq, OpenRouter, et
# les serveurs locaux ou auto-hébergés (Ollama, vLLM, LM Studio…).
# Choisissez UNE option, puis redémarrez l'application.
#
# OPTION 1 — DeepSeek (payant, très bon marché ; recommandé) :
#   clé sur https://platform.deepseek.com/api_keys
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-votre-cle-deepseek
#   Modèle par défaut : deepseek-chat (DeepSeek-V3). Le raisonneur
#   deepseek-reasoner (R1) fonctionne aussi, plus lent :
# LLM_MODEL=deepseek-chat
#
# OPTION 2 — GRATUITE (pour tester) : Google Gemini.
#   Clé sur https://aistudio.google.com/apikey (elle commence par AIza).
# LLM_PROVIDER=gemini
# LLM_API_KEY=votre-cle-gemini
#   Autres fournisseurs en ligne pris en charge, même principe :
#   LLM_PROVIDER=openai      (clé sur https://platform.openai.com)
#   LLM_PROVIDER=groq        (gratuit, clé sur https://console.groq.com)
#   LLM_PROVIDER=openrouter  (modèles ':free', clé sur https://openrouter.ai)
#   ⚠ Offres gratuites : le fournisseur peut utiliser les contenus
#   envoyés pour améliorer ses modèles. Parfait pour tester —
#   à ÉVITER pour les documents confidentiels ou de marque.
#
# OPTION 3 — IA LOCALE ou AUTO-HÉBERGÉE (aucune donnée ne sort du
#   serveur, aucune clé) : Ollama, vLLM ou tout serveur compatible.
#   Ollama : https://ollama.com/download puis « ollama pull deepseek-r1:8b »
# LLM_PROVIDER=ollama
# LLM_MODEL=deepseek-r1:8b
# LLM_BASE_URL=http://localhost:11434/v1   (valeur par défaut, à changer si distant)
#   vLLM : « vllm serve deepseek-ai/DeepSeek-V3 » puis
# LLM_PROVIDER=vllm
# LLM_MODEL=deepseek-ai/DeepSeek-V3
# LLM_BASE_URL=http://localhost:8000/v1
#   Autre serveur (LM Studio, LocalAI, proxy d'entreprise…) :
# LLM_PROVIDER=compatible
# LLM_BASE_URL=http://serveur:8080/v1
# LLM_MODEL=nom-du-modele-servi
# LLM_API_KEY=                              (seulement si le serveur l'exige)
#
# OPTION 4 — Anthropic (API Anthropic, pas le protocole OpenAI) :
ANTHROPIC_API_KEY=votre-cle-api-anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5
#
# OPTION 5 — Simulation, sans aucune clé ni réseau : contenus de
# démonstration étiquetés [DÉMO], pipeline complet testable.
# ELITE_IA_MODE=simulation
#
# Réglages avancés (facultatifs, tous fournisseurs) :
# LLM_BASE_URL=       URL de base de l'API (sans /chat/completions) ;
#                     remplace celle du fournisseur (proxy, région…).
# LLM_MODEL=          nom du modèle ; remplace le modèle par défaut.
# LLM_MAX_TOKENS=     plafond de jetons en sortie (DeepSeek : 8192 max).
# LLM_TIMEOUT_MS=     délai maximal d'un appel (180000 par défaut) ;
#                     à augmenter pour un modèle local lent.
# LLM_TEMPERATURE=    créativité 0–2 (défaut du fournisseur si vide).
# LLM_JSON_MODE=      auto (défaut) | on | off : demander au serveur une
#                     sortie JSON stricte (response_format). En auto, activé
#                     pour DeepSeek, OpenAI, Gemini, Groq, Ollama, vLLM. Si
#                     le serveur refuse, l'application rejoue sans et
#                     extrait le JSON de la réponse textuelle.

# --- Sessions hybrides (lot 17) ---
# Secret partagé du webhook de transcription (tl;dv ou autre outil) :
# à envoyer dans l'en-tête `x-webhook-secret` des appels POST vers
# /api/tldv/webhook. Sans cette variable, le webhook refuse tout.
TLDV_WEBHOOK_SECRET=
