# ============================================================
# Elite Academy – variables d'environnement
# Copier ce fichier vers .env.local puis remplir les valeurs.
# NE JAMAIS committer .env.local ni exposer les clés secrètes.
# ============================================================

# --- Supabase (projet à créer sur https://supabase.com) ---
# URL du projet (publique, visible côté navigateur)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé "anon" publique (protégée par Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé "service_role" – STRICTEMENT côté serveur.
# Utilisée uniquement par les actions serveur / Edge Functions.
# Jamais préfixée NEXT_PUBLIC_. Jamais dans le code frontend.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# --- Génération IA (appels uniquement côté serveur) ---
# Plusieurs façons d'activer l'IA — choisissez-en UNE :
#
# OPTION 1 — GRATUITE (recommandée pour tester) : Google Gemini.
#   Créez une clé sur https://aistudio.google.com (Get API key),
#   puis décommentez ces deux lignes :
# LLM_PROVIDER=gemini
# LLM_API_KEY=votre-cle-gemini
#   Autres fournisseurs gratuits pris en charge :
#   LLM_PROVIDER=groq       (clé sur https://console.groq.com)
#   LLM_PROVIDER=openrouter (clé sur https://openrouter.ai)
#   Modèle par défaut : gemini-2.5-flash / llama-3.3-70b ; remplaçable :
# LLM_MODEL=
#   ⚠ Offres gratuites : le fournisseur peut utiliser les contenus
#   envoyés pour améliorer ses modèles. Parfait pour tester —
#   à ÉVITER pour les documents confidentiels ou de marque.
#
# OPTION 1 bis — DeepSeek (payante, très peu coûteuse) :
#   Clé sur https://platform.deepseek.com (crédit prépayé), puis :
# LLM_PROVIDER=deepseek
# LLM_API_KEY=votre-cle-deepseek
#   Modèle par défaut : deepseek-chat (réponses limitées à 8 192 jetons,
#   suffisant pour une formation de taille courante). Pour le
#   raisonnement : LLM_MODEL=deepseek-reasoner
#   ⚠ Les données sont traitées sur des serveurs en Chine : à éviter
#   pour les transcriptions de sessions (noms d'apprenants) et les
#   documents confidentiels des clients.
#
# OPTION 2 — Anthropic (payante, recommandée en production) :
ANTHROPIC_API_KEY=votre-cle-api-anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5
#
# OPTION 3 — Simulation, sans aucune clé ni réseau : contenus de
# démonstration étiquetés [DÉMO], pipeline complet testable.
# ELITE_IA_MODE=simulation

# --- Sessions hybrides (lot 17) ---
# Secret partagé du webhook de transcription (tl;dv ou autre outil) :
# à envoyer dans l'en-tête `x-webhook-secret` des appels POST vers
# /api/tldv/webhook. Sans cette variable, le webhook refuse tout.
TLDV_WEBHOOK_SECRET=

# --- Visio Google Meet (lot 19) ---
# Facultatif. Sans ces trois variables, le formateur colle lui-même un
# lien Meet ; avec elles, la plateforme crée la salle et reprend la
# présence des participants à distance à la clôture.
#
# 1. Google Cloud (projet d'Elite) : activer « Google Meet REST API »,
#    créer un compte de service, générer une clé JSON.
# 2. Console d'administration Google Workspace → Sécurité → Contrôle de
#    l'accès aux API → Délégation au niveau du domaine : ajouter l'ID
#    client du compte de service avec la portée
#    https://www.googleapis.com/auth/meetings.space.created
# 3. Recopier ci-dessous l'e-mail et la clé privée du JSON, et le
#    compte Workspace au nom duquel les salles sont créées.
GOOGLE_MEET_CLIENT_EMAIL=
# Clé privée du JSON, entre guillemets, avec les \n tels quels :
GOOGLE_MEET_PRIVATE_KEY=
# Ex. : formations@lelabodelite.com (compte avec licence Meet)
GOOGLE_MEET_ORGANISATEUR=
